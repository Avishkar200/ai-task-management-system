{
  "info": {
    "name": "AI Task Manager API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection covering registration, login, user task flows, admin task flows, and AI generation endpoints."
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"new@example.com\",\n  \"password\": \"NewPass123!\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/auth/register",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"AlicePass123!\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/auth/login",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "User - List Tasks",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/tasks",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "tasks"]
        }
      }
    },
    {
      "name": "User - Create Task",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Write tests\",\n  \"description\": \"Cover permission checks for user tasks\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/tasks",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "tasks"]
        }
      }
    },
    {
      "name": "User - Forbidden Access to Another User Task",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/tasks/999",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "tasks", "999"]
        }
      }
    },
    {
      "name": "Admin - List Users",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/admin/users",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "admin", "users"]
        }
      }
    },
    {
      "name": "Admin - Update Task Status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"In Progress\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/tasks/1/status",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "tasks", "1", "status"]
        }
      }
    },
    {
      "name": "AI - Generate Description",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Plan launch\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/tasks/generate-description",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "tasks", "generate-description"]
        }
      }
    }
  ],
  "variable": [
    { "key": "user_token", "value": "replace-with-user-jwt" },
    { "key": "admin_token", "value": "replace-with-admin-jwt" }
  ]
}
